#!/bin/sh

[ -n "$IPKG_INSTROOT" ] && exit 0

if [ -f /etc/config/fptn.apk-new ]; then
	mv -f /etc/config/fptn.apk-new /etc/config/fptn
fi

if [ -f /etc/uci-defaults/99-fptn ]; then
	( . /etc/uci-defaults/99-fptn ) && rm -f /etc/uci-defaults/99-fptn
fi

/etc/init.d/fptn enable

# The web page is its own package since 0.4.26, and upgrading from an older
# one removes the files it used to carry - so the cached menu is dropped here,
# but rpcd is left alone: only luci-app-fptn brings an ACL, and restarting rpcd
# would end the LuCI session of whoever is installing.
rm -f /tmp/luci-indexcache* /tmp/luci-modulecache/* 2>/dev/null

exit 0
