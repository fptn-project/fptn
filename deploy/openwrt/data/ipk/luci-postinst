#!/bin/sh

[ -n "$IPKG_INSTROOT" ] && exit 0

# LuCI caches the menu and rpcd caches the ACLs: without this the page stays
# invisible until a reboot. Reload rather than restart - a restart of rpcd
# invalidates the session and throws whoever is installing out of LuCI.
rm -f /tmp/luci-indexcache* /tmp/luci-modulecache/* 2>/dev/null
/etc/init.d/rpcd reload >/dev/null 2>&1

exit 0
