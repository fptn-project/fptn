config fptn 'config'
	option enabled '0'
	option access_token ''
	option preferred_server ''
	option out_network_interface ''
	option tun_interface_name 'tun0'
	option sni ''
	option bypass_method 'obfuscation'
	option connection_strategy 'dual-rolling-tunnel'
	option mtu_size '1420'
	option dns ''
	option use_fptn_dns '1'
	option enable_ad_block '1'
	option enable_split_tunnel '1'
	option split_tunnel_mode 'exclude'
	list exclude_tunnel_networks '10.0.0.0/8'
	list exclude_tunnel_networks '172.16.0.0/12'
	list exclude_tunnel_networks '192.168.0.0/16'
	list blacklist_domains 'solovev-live.ru'
	list blacklist_domains 'ria.ru'
	list blacklist_domains 'tass.ru'
	list blacklist_domains '1tv.ru'
	list blacklist_domains 'ntv.ru'
	list blacklist_domains 'rt.com'
	list blacklist_domains 'lenta.ru'
